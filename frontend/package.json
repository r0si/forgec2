{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:contrast": "node scripts/check-contrast.mjs --strict",
    "check:aria": "node scripts/check-aria.mjs --strict",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "check:css": "node scripts/check-css.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:webdist": "node ../scripts/check-webdist.mjs",
    "check:readme": "node ../scripts/gen-readme-facts.mjs --check && node ../scripts/check-readme-parity.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-bootstrap": "node scripts/gen-i18n-bootstrap.mjs --check",
    "check:paths": "node scripts/check-api-paths.mjs",
    "check:native-dialogs": "node scripts/check-native-dialogs.mjs",
    "check:openapi-types": "node scripts/check-openapi-types.mjs",
    "check:openapi-envelope": "node ../scripts/apply-openapi-envelope.mjs --check",
    "check:route-auth": "node ../scripts/check-route-auth.mjs",
    "check:context-keys": "node ../scripts/check-context-keys.mjs",
    "check:error-sanitization": "node ../scripts/check-error-sanitization.mjs",
    "check:tx-queries": "node ../scripts/check-tx-queries.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "audit:unused-exports": "node scripts/audit-unused-exports.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "gen:openapi": "openapi-typescript ../api/openapi.yaml -o src/lib/api-schema.d.ts",
    "gen:permissions": "node scripts/gen-permissions.mjs",
    "check": "npx concurrently -n css,tokens,contrast,aria,i18n,paths,dialogs,openapi,perms,layout,webdist,bundle,readme,routeauth,ctxkeys,errsanitize,txqueries \"npm:check:css\" \"npm:check:tokens\" \"npm:check:contrast\" \"npm:check:aria\" \"npm:check:i18n\" \"npm:check:paths\" \"npm:check:native-dialogs\" \"npm:check:openapi-types\" \"npm:check:permissions\" \"npm:check:layout\" \"npm:check:webdist\" \"npm:check:bundle\" \"npm:check:readme\"",
    "check:pre": "npx concurrently -n css,tokens,i18n,paths,dialogs,openapi,perms,layout,readme,routeauth,ctxkeys,errsanitize,txqueries \"npm:check:css\" \"npm:check:tokens\" \"npm:check:i18n\" \"npm:check:paths\" \"npm:check:native-dialogs\" \"npm:check:openapi-types\" \"npm:check:permissions\" \"npm:check:layout\" \"npm:check:readme\"",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check",
    "check:audit": "node scripts/check-audit.mjs"
  },
  "dependencies": {
    "@base-ui/react": "~1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.30",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "tinypool": "^2.1.2"
  }
}
