# Copy to .env next to docker-compose.yml (chmod 600). deploy.sh generates
# this file with fresh random values when it is missing; the placeholders
# below exist so the shape of the file is documented.
#
# Every value here is a demo-only secret. Never reuse it for a real
# deployment: the demo database, keys and accounts are public.

# Image to run. Defaults to the published edge build; set a mirror or a digest
# when the host cannot reach GHCR directly (see docker-compose.yml).
FORGEC2_IMAGE=ghcr.io/r0si/forgec2:edge

# PostgreSQL role password for the host cluster (127.0.0.1:5432).
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Independent storage keys. Each one is 32 random bytes, hex encoded.
FORGEC2_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
FORGEC2_LOOT_KEY=REPLACE_WITH_64_HEX_CHARS
FORGEC2_EXTC2_KEY=REPLACE_WITH_64_HEX_CHARS
FORGEC2_BACKUP_KEY=REPLACE_WITH_64_HEX_CHARS
FORGEC2_TOTP_KEY=REPLACE_WITH_64_HEX_CHARS
FORGEC2_CSRF_KEY=REPLACE_WITH_64_HEX_CHARS

# First-boot admin password, used only by deploy.sh to provision and then
# disable the admin. Generate a fresh one; do not reuse a real credential.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Password for the public read-only observer account.
DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD
